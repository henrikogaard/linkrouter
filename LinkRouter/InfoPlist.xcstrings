{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAppleEventsUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LinkRouter reads the front browser's current page when you ask it to open that page in another browser."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LinkRouter leser den gjeldende siden i nettleseren når du ber appen åpne siden i en annen nettleser."
          }
        }
      }
    },
    "NSLocationUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LinkRouter uses your Wi-Fi network name to match rules. Your location is never stored or sent anywhere."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LinkRouter bruker navnet på Wi-Fi-nettverket ditt til å matche regler. Posisjonen din lagres eller sendes aldri noe sted."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LinkRouter uses your Wi-Fi network name to match rules. Your location is never stored or sent anywhere."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LinkRouter bruker navnet på Wi-Fi-nettverket ditt til å matche regler. Posisjonen din lagres eller sendes aldri noe sted."
          }
        }
      }
    }
  },
  "version" : "1.0"
