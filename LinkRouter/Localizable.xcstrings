    "%1$@ applies a profile only when it starts cold. Open a separate %2$@ instance for this profile, or open the link in the running %3$@ without a profile.": {
      "localizations": {
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bruker en profil bare når den startes helt på nytt. Åpne en egen %2$@-instans for denne profilen, eller åpne lenken i den kjørende %3$@ uten profil."
          }
        }
      }
    },
